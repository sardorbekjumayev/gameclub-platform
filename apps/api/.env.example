NODE_ENV=development
PORT=4700
DATABASE_URL=postgresql://gc:gc@localhost:55432/gameclub?schema=public
REDIS_URL=redis://localhost:56379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
QR_HMAC_SECRET=change-me-qr-hmac-secret-min-32-chars!!
CORS_ORIGINS=http://localhost:4710,http://localhost:4720
APP_TIMEZONE_DEFAULT=Asia/Tashkent
# Fayllar (o'tkazma cheklari, logo, hujjatlar) shu papkada saqlanadi — prod'da doimiy volume va backup
STORAGE_DIR=./storage
UPLOAD_MAX_MB=10
SUPER_ADMIN_EMAIL=admin@gameclub.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Telegram bot (login kodi shu bot orqali). @BotFather'dan token oling. Bo'sh bo'lsa dev'da kod 000000.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
# Prod (TELEGRAM_MODE=webhook): https://<api-domen>/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# To'lov provayderlari (bo'sh bo'lsa o'chiq). Webhook manzillari:
#   Payme merchant API:  {PUBLIC_API_URL}/webhooks/payments/payme   (Basic auth Paycom:<PAYME_KEY>)
#   Click prepare/complete: {PUBLIC_API_URL}/webhooks/payments/click/prepare | /complete
PUBLIC_API_URL=http://localhost:4700/api/v1
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=true
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
# Push bildirishnomalar: Firebase service account JSON (bir qatorda yoki base64)
FCM_SERVICE_ACCOUNT=

# Rate limit: <so'rov soni>/<oyna, soniya>, kalit — user id (token bo'lsa) yoki IP. Bo'sh — standart.
#   GLOBAL — har bir kalit uchun barcha marshrutlar bo'yicha umumiy
#   PUBLIC — ommaviy o'qish (filial, bo'sh joylar, slotlar, xarita, qidiruv), marshrut bo'yicha
#   WRITE — bron, arenda, o'tkazma, sharh, murojaat, sevimlilar; SENSITIVE — login/OTP/parol/taklif/QR
#   PROMO — promo-kod urinishlari (validate + price-quote + bron birgalikda)
RATE_LIMIT_GLOBAL=300/60
RATE_LIMIT_PUBLIC=120/60
RATE_LIMIT_WRITE=30/60
RATE_LIMIT_SENSITIVE=20/300
RATE_LIMIT_PROMO=10/600
